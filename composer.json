{
  "name": "crossknowledge/datatable-bundle",
  "description": "Server side implementation of datatables.net library for Symfony2",
  "type": "symfony-bundle",
  "license": "MIT",
  "keywords": [
    "datatables.net",
    "Datatables",
    "HTML Table",
    "Symfony"
  ],
  "authors": [
    {
      "name": "Cyril Quintin",
      "email": "cyril.quintin@gmail.com"
    }
  ],
  "autoload": {
    "psr-4": { "CrossKnowledge\\DataTableBundle\\": "" }
  },
  "require": {
    "php": ">=5.5",
    "symfony/flex": "^1.0",
    "symfony/form": "^5.4",
    "symfony/options-resolver": "^5.4",
    "symfony/property-access": "^5.4",
    "symfony/property-info": "^5.4",
    "symfony/string": "^5.4",
    "symfony/http-foundation": "^5.4",
    "symfony/http-kernel": "^5.4",
    "symfony/dependency-injection": "^5.4",
    "symfony/config": "^5.4",
    "symfony/yaml": "^5.4",
    "twig/twig": "^2.0|^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^8",
    "symfony/phpunit-bridge": "^6"
  },
  "extra": {
    "symfony": {
      "allow-contrib": true,
      "require": "5.*"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/flex": true
    }
  }
}
